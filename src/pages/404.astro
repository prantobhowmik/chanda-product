---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="container nf">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="muted">The page you are looking for does not exist or has moved.</p>
    <Button href="/" size="lg">Go to the home page</Button>
  </section>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-top: 96px;
    padding-bottom: 40px;
    min-height: 60vh;
  }
</style>
