---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import DownloadCard from '../components/DownloadCard.astro';
import Step from '../components/Step.astro';
import { site } from '../config/site';

const androidFoot = [`Android ${site.androidMin} or newer`, site.apkSizeMb ? `${site.apkSizeMb} MB` : null]
  .filter(Boolean)
  .join(' · ');
const webHost = new URL(site.webAppUrl).host;
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Download"
  description={`Get Chanda ${site.version}: use the web app now, install the Android APK directly, and iOS is coming soon.`}
  section="download"
>
  <section class="container head">
    <p class="eyebrow">Download</p>
    <h1>Get Chanda for your phone.</h1>
    <p class="head__lead muted">
      Use it in your browser or install the Android app from this site. iOS is coming soon.
    </p>
  </section>

  <section class="container cards" aria-label="Platforms">
    <DownloadCard title="Android" badge={`Version ${site.version}`} primary>
      Not on the Play Store yet. Download the APK directly and install it on your phone.
      <Fragment slot="action">
        <Button href={site.apkUrl} size="lg" block disabledLabel="APK link coming soon" data-apk-btn>
          Download APK &middot; v{site.version}
        </Button>
      </Fragment>
      <Fragment slot="foot">{androidFoot}</Fragment>
    </DownloadCard>

    <DownloadCard title="iOS" badge="Coming soon" badgeTone="neutral">
      An iPhone version is coming soon.
      <Fragment slot="action">
        <Button size="lg" block disabledLabel="Coming soon">Coming soon</Button>
      </Fragment>
      <Fragment slot="foot">&nbsp;</Fragment>
    </DownloadCard>

    <DownloadCard title="Web" badge="Available now">
      Use Chanda in any modern browser. Nothing to install.
      <Fragment slot="action">
        <Button href={site.webAppUrl} variant="secondary" size="lg" block external>Open web app</Button>
      </Fragment>
      <Fragment slot="foot">{webHost}</Fragment>
    </DownloadCard>
  </section>

  <section class="section container" id="install" aria-labelledby="install-title">
    <h2 id="install-title" class="h2-s">Install on Android</h2>
    <ol class="steps">
      <Step n="01" title="Download the APK">
        Tap the download button on your phone and wait for the file to finish downloading.
      </Step>
      <Step n="02" title="Allow installs from this source">
        Android will ask you to allow your browser to install apps from outside the Play Store. Allow it for this
        download.
      </Step>
      <Step n="03" title="Open the file and tap Install">
        Open the downloaded file and tap Install. Android warns about apps from outside the Play Store. That is
        expected for a direct APK install.
      </Step>
      <Step n="04" title="Sign in">Open Chanda and sign in. Recording works offline after you have signed in.</Step>
    </ol>
  </section>

  <section class="section container info" aria-label="Requirements and release notes">
    <article class="panel">
      <h2>Requirements</h2>
      <ul>
        <li>Web: any modern browser</li>
        <li>Android app: {site.androidMin} or newer</li>
        <li>Internet is needed for sign in, sync and backup only</li>
        <li>Recording works offline after sign in</li>
        <li>Allow notifications to receive approval alerts</li>
      </ul>
    </article>

    <article class="panel">
      <h2>Release notes</h2>
      {
        site.releases.map((r, i) => (
          <div class="release">
            <h3>
              {r.version}
              {r.date && <span class="muted"> &middot; {fmt(r.date)}</span>}
              {i === 0 && <span class="latest">Latest</span>}
            </h3>
            <ul>
              {r.notes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </article>
  </section>
</BaseLayout>

<style>
  @media (max-width: 520px) {
    .head {
      padding-top: 32px;
    }
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 800px;
    padding-top: 56px;
    padding-bottom: 24px;
    text-align: center;
  }
  .head h1 {
    font-size: clamp(2.25rem, 1.1rem + 4.6vw, 3.5rem);
  }
  .head__lead {
    font-size: var(--fs-lead);
  }
  .cards {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    padding-top: 24px;
  }
  .h2-s {
    margin-bottom: 32px;
    font-size: clamp(1.625rem, 1.2rem + 1.5vw, 2.125rem);
  }
  .steps {
    display: grid;
    gap: 32px;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .info {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    align-items: start;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
  }
  .panel h2 {
    font-size: 1.125rem;
    letter-spacing: 0;
  }
  .panel ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 1.2em;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .release h3 {
    margin-bottom: 8px;
    font-size: 1rem;
  }
  .latest {
    margin-left: 10px;
    padding: 3px 10px;
    border-radius: 99px;
    background: var(--teal-soft);
    color: var(--teal);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .release + .release {
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
</style>

<script>
  const btn = document.querySelector<HTMLAnchorElement>('[data-apk-btn]');
  if (btn) {
    const original = btn.innerHTML;
    btn.addEventListener('click', () => {
      if (btn.getAttribute('aria-busy') === 'true') return;
      btn.setAttribute('aria-busy', 'true');
      btn.innerHTML = '<span class="spinner" aria-hidden="true"></span>&nbsp;&nbsp;Starting download\u2026';
      window.setTimeout(() => {
        btn.innerHTML = original;
        btn.removeAttribute('aria-busy');
      }, 4000);
    });
  }
</script>
