---
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import DocsSearch from '../components/DocsSearch.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import DocsToc from '../components/DocsToc.astro';
import { getDocs, docHref, type Doc } from '../lib/docs';

interface Props {
  entry: Doc;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const all = await getDocs();
const i = all.findIndex((d) => d.id === entry.id);
const prev = i > 0 ? all[i - 1] : undefined;
const next = i < all.length - 1 ? all[i + 1] : undefined;
---

<BaseLayout title={entry.data.title} description={entry.data.description} section="docs">
  <DocsSearch slot="nav" />
  <div slot="main-wrapper" class="docs container">
    <aside class="docs__side"><DocsSidebar currentId={entry.id} /></aside>

    <main id="main" class="docs__main">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/docs/getting-started">Docs</a></li>
          <li>{entry.data.group}</li>
          <li aria-current="page">{entry.data.title}</li>
        </ol>
      </nav>
      <h1>{entry.data.title}</h1>
      <p class="docs__lead muted">{entry.data.description}</p>
      <article class="prose">
        <Content />
      </article>

      <nav class="pager" aria-label="Previous and next pages">
        {
          prev ? (
            <a class="pager__link" href={docHref(prev)} rel="prev">
              <span class="pager__label">Previous</span>
              <span class="pager__title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="pager__link pager__link--next" href={docHref(next)} rel="next">
              <span class="pager__label">Next</span>
              <span class="pager__title">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </main>

    <aside class="docs__toc"><DocsToc headings={headings} /></aside>
  </div>
</BaseLayout>

<style>
  .docs {
    display: grid;
    gap: 32px;
    padding-top: 32px;
  }
  .docs__main {
    min-width: 0;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .docs__main h1 {
    font-size: clamp(2rem, 1.2rem + 3vw, 2.875rem);
  }
  .docs__lead {
    font-size: var(--fs-lead);
    line-height: 1.6;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .crumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 8px;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--teal);
    font-weight: 600;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 24px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .pager__link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 160px;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface);
    transition: border-color var(--ease);
  }
  .pager__link--next {
    margin-left: auto;
    text-align: right;
  }
  .pager__link:hover {
    border-color: var(--teal);
  }
  .pager__label {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .pager__title {
    font-weight: 700;
    color: var(--teal);
  }

  @media (min-width: 1024px) {
    .docs {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 56px;
      padding-top: 48px;
    }
    .docs__toc {
      display: none;
    }
  }
  @media (min-width: 1180px) {
    .docs {
      grid-template-columns: 220px minmax(0, 720px) 200px;
      justify-content: space-between;
    }
    .docs__toc {
      display: block;
    }
  }
</style>
