---
interface Props {
  title: string;
  badge: string;
  primary?: boolean;
  badgeTone?: 'teal' | 'neutral';
}
const { title, badge, primary = false, badgeTone = 'teal' } = Astro.props;
---

<article class:list={['dl', { 'dl--primary': primary }]}>
  <header class="dl__head">
    <h2>{title}</h2>
    <span class:list={['dl__badge', `dl__badge--${badgeTone}`]}>{badge}</span>
  </header>
  <p class="dl__body"><slot /></p>
  <div class="dl__action"><slot name="action" /></div>
  <p class="dl__foot"><slot name="foot" /></p>
</article>

<style>
  .dl {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
  }
  .dl--primary {
    border: 2px solid var(--teal);
  }
  .dl__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  h2 {
    font-size: 1.375rem;
    letter-spacing: 0;
    line-height: 1.2;
  }
  .dl__badge {
    padding: 6px 12px;
    border-radius: 99px;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .dl__badge--teal {
    background: var(--teal-soft);
    color: var(--teal);
  }
  .dl__badge--neutral {
    background: var(--ground);
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .dl__body {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.6;
  }
  .dl__action {
    margin-top: auto;
  }
  @media (max-width: 520px) {
    .dl {
      padding: 24px;
    }
  }
  .dl__foot {
    color: var(--muted);
    font-size: 0.8125rem;
    min-height: 1.2em;
  }
</style>
