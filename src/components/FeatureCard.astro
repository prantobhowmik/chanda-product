---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon: IconName;
  title: string;
}
const { icon, title } = Astro.props;
---

<article class="card">
  <div class="card__icon"><Icon name={icon} /></div>
  <h3>{title}</h3>
  <p><slot /></p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-s);
    background: var(--teal-soft);
    color: var(--teal);
  }
  p {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.6;
  }
</style>
