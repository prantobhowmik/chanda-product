---
import Icon from './Icon.astro';
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Theme: system. Switch to light">
  <span class="icon icon--system"><Icon name="system" size={20} /></span>
  <span class="icon icon--sun"><Icon name="sun" size={20} /></span>
  <span class="icon icon--moon"><Icon name="moon" size={20} /></span>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-s);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--ease),
      color var(--ease);
  }
  .theme-toggle:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .icon {
    display: none;
  }
  :global(:root[data-theme-mode='system']) .icon--system,
  :global(:root[data-theme-mode='light']) .icon--sun,
  :global(:root[data-theme-mode='dark']) .icon--moon {
    display: inline-flex;
  }
</style>

<script>
  const root = document.documentElement;
  const order = ['system', 'light', 'dark'] as const;
  type Mode = (typeof order)[number];
  const after = (m: Mode): Mode => order[(order.indexOf(m) + 1) % order.length] ?? 'system';

  const current = (): Mode => {
    const t = root.getAttribute('data-theme');
    return t === 'light' || t === 'dark' ? t : 'system';
  };

  const apply = (mode: Mode) => {
    if (mode === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', mode);
    root.setAttribute('data-theme-mode', mode);
    const next = after(mode);
    document
      .querySelectorAll('[data-theme-toggle]')
      .forEach((b) => b.setAttribute('aria-label', `Theme: ${mode}. Switch to ${next}`));
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = after(current());
      apply(next);
      try {
        if (next === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable */
      }
    });
  });
  apply(current());
</script>
