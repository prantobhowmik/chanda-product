---
import { site } from '../config/site';
---

<footer class="footer">
  <div class="container footer__inner">
    <span class="footer__brand" lang="bn">{site.nameBn}</span>
    <nav aria-label="Footer">
      <ul class="footer__links">
        <li><a href="/docs/getting-started">Docs</a></li>
        <li><a href="/download">Download</a></li>
        <li><a href={site.webAppUrl} rel="noopener">Open web app</a></li>
        {site.contactEmail && <li><a href={`mailto:${site.contactEmail}`}>Contact</a></li>}
      </ul>
    </nav>
    <p class="footer__meta">Version {site.version} &middot; {site.license} licence</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section);
    border-top: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 28px;
  }
  .footer__brand {
    font-family: var(--font-bn);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    list-style: none;
    padding: 0;
  }
  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--ease);
  }
  .footer__links a:hover {
    color: var(--teal);
  }
</style>
