---
const recent = [
  { name: 'Donation', meta: 'bKash', amount: '+ ৳ 2,000', kind: 'in' },
  { name: 'Venue rental', meta: 'Cash', amount: '- ৳ 5,500', kind: 'out' },
  { name: 'Donation', meta: 'Bank', amount: '+ ৳ 10,000', kind: 'in' },
];
---

<figure class="phone" aria-label="Illustration of the Chanda dashboard with sample data">
  <div class="phone__frame">
    <div class="screen">
      <div class="screen__top">
        <span class="screen__title">Dashboard</span>
        <span class="screen__chip">Sample festival</span>
      </div>
      <div class="balance">
        <span class="balance__label">Current balance</span>
        <span class="balance__value">৳ 48,250</span>
        <span class="balance__split"><span>In ৳ 72,000</span><span>Out ৳ 23,750</span></span>
      </div>
      <div class="synced"><span class="synced__dot"></span>All changes synced</div>
      <span class="screen__sub">Recent</span>
      <ul class="rows">
        {
          recent.map((r) => (
            <li class="row">
              <span class="row__text">
                <span class="row__name">{r.name}</span>
                <span class="row__meta">{r.meta}</span>
              </span>
              <span class:list={['row__amt', r.kind]}>{r.amount}</span>
            </li>
          ))
        }
      </ul>
      <span class="screen__note">Sample data</span>
    </div>
  </div>
</figure>

<style>
  /* The mock mirrors the app's light UI and stays light in both site themes. */
  .phone {
    display: flex;
    justify-content: center;
  }
  .phone__frame {
    width: 300px;
    height: 600px;
    padding: 10px;
    border-radius: 44px;
    background: #0e1e1f;
    box-shadow: 0 40px 80px -30px rgba(15, 118, 110, 0.45);
  }
  .screen {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 16px 16px;
    border-radius: 36px;
    background: #f5f8f8;
    color: #0e1e1f;
    overflow: hidden;
  }
  .screen__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .screen__title {
    font-weight: 800;
    font-size: 1.125rem;
  }
  .screen__chip {
    font-size: 0.75rem;
    font-weight: 600;
    color: #0f766e;
    background: #e6f4f2;
    padding: 6px 10px;
    border-radius: 99px;
  }
  .balance {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border-radius: var(--radius-l);
    background: linear-gradient(160deg, #0f766e, #115e59);
    color: #fff;
  }
  .balance__label {
    font-size: 0.75rem;
    font-weight: 600;
  }
  .balance__value {
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .balance__split {
    display: flex;
    gap: 18px;
    margin-top: 8px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .synced {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: var(--radius-s);
    background: #e6f4f2;
    color: #17795a;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .synced__dot {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: #17795a;
  }
  .screen__sub {
    font-weight: 700;
    font-size: 0.8125rem;
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    background: #fff;
    border: 1px solid #dce5e5;
    border-radius: 14px;
  }
  .row__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .row__name {
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .row__meta {
    font-size: 0.75rem;
    color: #4f6567;
  }
  .row__amt {
    font-size: 0.8125rem;
    font-weight: 800;
  }
  .in {
    color: #17795a;
  }
  .out {
    color: #c2410c;
  }
  .screen__note {
    margin-top: auto;
    text-align: center;
    font-size: 0.75rem;
    color: #4f6567;
  }
</style>
