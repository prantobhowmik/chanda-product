---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 22 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={icons[name]}></path></svg>
